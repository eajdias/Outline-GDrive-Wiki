# Outline Secrets (generate with: openssl rand -hex 32)
SECRET_KEY=
UTILS_SECRET=

# Database Configuration
POSTGRES_USER=outline
POSTGRES_PASSWORD=
POSTGRES_DB=outline
DATABASE_URL=postgres://outline:POSTGRES_PASSWORD@postgres:5432/outline

# Redis Configuration
REDIS_URL=redis://redis:6379

# Outline Public URL
URL=http://127.0.0.1:8091
PORT=3000
# Acesso direto em loopback (nunca 0.0.0.0): ajuste se a porta estiver ocupada no host
OUTLINE_DIRECT_PORT=3000
UPLOADS_DIRECT_PORT=8080

# File Storage Configuration (local)
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data

# Outline API key do serviço importador (real value only in .env)
OUTLINE_API_KEY=

# Chat valida a sessão do Outline por aqui (interno ao compose)
OUTLINE_AUTH_URL=http://outline:3000

# Local e teste HTTP via tailnet: false. Atrás de reverse proxy com TLS (vps com domínio, prod): true.
FORCE_HTTPS=false

# Same-machine Postgres uses no SSL (official .env.sample guidance)
PGSSLMODE=disable

# Email sign-in via magic link (Outline exige ≥1 auth provider para mostrar login)
SMTP_SERVICE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- AnythingLLM (headless, API only) ---
# O LLM aponta para o llm-gateway (rede interna), nunca direto para o provedor.
# llm-gateway é quem guarda as chaves e decide a rota.
LLM_PROVIDER=generic-openai
EMBEDDING_ENGINE=generic-openai
GEMINI_LLM_MODEL_PREF=gemini-2.5-flash-lite
EMBEDDING_MODEL_PREF=gemini-embedding-001
# Dimensão do vetor gravado no LanceDB. Não mude depois do primeiro seed:
# o índice existente fica incompatível e exige reingestão.
EMBEDDING_OUTPUT_DIMENSIONS=2048
VECTOR_DB=lancedb
# JWT_SECRET e AUTH_TOKEN do AnythingLLM (não são os mesmos do Outline)
ANYTHINGLLM_JWT_SECRET=
ANYTHINGLLM_AUTH_TOKEN=
# Gerado no primeiro boot: POST /api/request-token + POST /api/admin/generate-api-key
ANYTHINGLLM_API_KEY=
# Workspace consultado pelo chat (lista separada por vírgula; hoje só kb-drive).
ANYTHINGLLM_WORKSPACES=kb-drive
LOG_LEVEL=info

# --- llm-gateway (apps/llm-gateway) ---
# Fica entre o AnythingLLM e os provedores. Rotaciona chaves no 429 (cota) e
# troca de provedor quando todas esgotam, para somar cotas free de várias contas.
# Ordem de fallback: LLM_GATEWAY_PROVIDERS, depois as chaves em ordem.
LLM_GATEWAY_PROVIDERS=gemini
# Chaves em ordem de preferência. Aceita também GEMINI_API_KEY único (legado).
# Ex.: GEMINI_API_KEYS=AIza-conta1,AIza-conta2,AIza-conta3
GEMINI_API_KEYS=
# Bearer exigido pelo gateway; o AnythingLLM recebe o mesmo valor.
# Vazio = sem auth (só aceitável porque a porta nunca é publicada).
LLM_GATEWAY_TOKEN=
# Tempo que uma chave fica fora de rotação depois de um 429 (padrão 15 min).
LLM_GATEWAY_KEY_COOLDOWN_MS=900000
# Provedor OpenAI-compatível alternativo (ex.: OpenRouter, Groq, LM Studio).
# Só é usado se listado em LLM_GATEWAY_PROVIDERS.
GENERIC_BASE_URL=
GENERIC_API_KEYS=
GENERIC_MODEL=
GENERIC_EMBEDDING_MODEL=

# --- importer (apps/importer) ---
# Caminho da chave JSON da service account: NO HOST, fora do repo.
# Pré-requisito GCP: Google Drive API e Google Docs API habilitadas; a SA usa
# drive.readonly + documents.readonly (imagens inline via /drive-image/).
DRIVE_SA_KEY_PATH=
# IDs do Drive compartilhado e da pasta raiz (descobertos por API)
DRIVE_ID=
DRIVE_ROOT_FOLDER_ID=
# Estado do importador: tabelas imports/meta/runs/dead_letters no Postgres do compose
STATE_DATABASE_URL=postgres://outline:POSTGRES_PASSWORD@postgres:5432/outline
# Outline (API interna + URL pública usada no metadata.url do RAG)
OUTLINE_API_URL=http://outline:3000
OUTLINE_PUBLIC_URL=http://127.0.0.1:8091
# Mapa pasta→coleção por ID (JSON: {"<folderId>":"<collectionId>"}); vazio = resolve por nome
OUTLINE_COLLECTION_MAP=
# Coleção default para pasta sem coleção homônima
OUTLINE_DEFAULT_COLLECTION_ID=
# Pastas ignoradas na importação (lista separada por vírgula)
IMPORT_DRIVE_IGNORE_FOLDERS=drafts
# Workspace do AnythingLLM alimentado pelo importador (criado se não existir)
IMPORT_DRIVE_RAG_WORKSPACE=kb-drive
# Webhook do Drive: URL HTTPS pública. Vazio = modo poll-only (apply por cron)
DRIVE_WEBHOOK_URL=
# Token ecoado em X-Goog-Channel-Token (valida a origem da notificação)
DRIVE_WEBHOOK_TOKEN=
IMPORT_DRIVE_PORT=8787
IMPORT_DEBOUNCE_MS=2000
IMPORT_DOCUMENT_DELAY_MS=0
# Poll de fallback do serve (webhook pode não chegar sem HTTPS público). 0 desliga.
DRIVE_POLL_INTERVAL_MS=900000
# Paralelismo da ingestão (docs simultâneos por seed/apply)
IMPORT_CONCURRENCY=4

# --- chat (apps/chat) ---
REDIS_URL=redis://redis:6379
# Porta interna do servidor do chat (o edge fala com ele em chat:8080)
CHAT_PORT=8080
CHAT_MIN_SCORE=0.65
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_MAX_QUESTION_CHARS=1000
CHAT_BODY_LIMIT_BYTES=8192
CHAT_TIMEOUT_MS=60000
# 1 = permite o widget/iframe do edge (necessário para a bolha no wiki).
# 0 = nega framing (X-Frame-Options DENY), só para rodar o chat standalone.
CHAT_ALLOW_EMBED=1

# --- edge (openresty em src/infra/edge/nginx.conf) ---
# Local publica 127.0.0.1:8091 (wiki + /chat/); host dedicado troca para 80/443 com TLS (overlay prod).
# IP de bind (nunca 0.0.0.0 em host com IP público: exporia o wiki à internet):
# 127.0.0.1 = só no host; IP do Tailscale (tailscale ip -4) = teste privado no tailnet.
EDGE_BIND_IP=127.0.0.1
EDGE_PORT=8091
# Host compartilhado (overlay vps): o edge segue em 127.0.0.1:8091 sem TLS e o reverse proxy do host
# (src/infra/host-nginx/wiki.conf.example) termina o TLS; URL, OUTLINE_PUBLIC_URL e CHAT_PUBLIC_URL
# apontam para https://<dominio-publico>. Trocar OUTLINE_PUBLIC_URL reindexa as citações no próximo seed.
# O edge repassa o cookie do Outline; o chat valida a sessão em OUTLINE_AUTH_URL.
EDGE_PORT=8091
# Origem pública do chat usada no snippet injetado e no CSP
CHAT_PUBLIC_URL=http://127.0.0.1:8091/chat
